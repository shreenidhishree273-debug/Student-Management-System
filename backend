
from flask import Flask, request, jsonify
import sqlite3

app = Flask(__name__)

# Database configuration
DATABASE = "students.db"


# Connect to database
def get_db_connection():
    conn = sqlite3.connect(DATABASE)
    conn.row_factory = sqlite3.Row
    return conn


# Create database table
def create_table():
    conn = get_db_connection()

    conn.execute("""
        CREATE TABLE IF NOT EXISTS students (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            rollNo TEXT UNIQUE NOT NULL,
            name TEXT NOT NULL,
            email TEXT NOT NULL,
            phone TEXT NOT NULL,
            department TEXT NOT NULL,
            year TEXT NOT NULL,
            gender TEXT NOT NULL
        )
    """)

    conn.commit()
    conn.close()


# Convert database row to dictionary
def student_to_dict(student):
    return {
        "id": student["id"],
        "rollNo": student["rollNo"],
        "name": student["name"],
        "email": student["email"],
        "phone": student["phone"],
        "department": student["department"],
        "year": student["year"],
        "gender": student["gender"]
    }


# Check student data
def validate_student(data):
    fields = [
        "rollNo",
        "name",
        "email",
        "phone",
        "department",
        "year",
        "gender"
    ]

    if not isinstance(data, dict):
        return "Invalid JSON data"

    for field in fields:
        if not isinstance(data.get(field), str):
            return field + " is required"

        if not data[field].strip():
            return field + " cannot be empty"

    if len(data["phone"].strip()) != 10 or not data["phone"].strip().isdigit():
        return "Phone number must contain 10 digits"

    return None


# HOME PAGE
@app.route("/", methods=["GET"])
def home():
    return jsonify({
        "message": "Student Management System Backend is running!",
        "endpoints": [
            "GET /students",
            "GET /students/<id>",
            "POST /students",
            "PUT /students/<id>",
            "DELETE /students/<id>",
            "GET /search?q=keyword"
        ]
    })


# CREATE - Add a new student
@app.route("/students", methods=["POST"])
def add_student():

    data = request.get_json(silent=True)

    error = validate_student(data)

    if error:
        return jsonify({"error": error}), 400

    conn = get_db_connection()

    try:
        cursor = conn.execute("""
            INSERT INTO students
            (rollNo, name, email, phone, department, year, gender)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (
            data["rollNo"].strip(),
            data["name"].strip(),
            data["email"].strip(),
            data["phone"].strip(),
            data["department"].strip(),
            data["year"].strip(),
            data["gender"].strip()
        ))

        conn.commit()

        student_id = cursor.lastrowid

        student = conn.execute(
            "SELECT * FROM students WHERE id = ?",
            (student_id,)
        ).fetchone()

        return jsonify({
            "message": "Student added successfully",
            "student": student_to_dict(student)
        }), 201

    except sqlite3.IntegrityError:
        return jsonify({
            "error": "Roll number already exists"
        }), 409

    finally:
        conn.close()


# READ - Get all students
@app.route("/students", methods=["GET"])
def get_students():

    conn = get_db_connection()

    students = conn.execute(
        "SELECT * FROM students ORDER BY id DESC"
    ).fetchall()

    conn.close()

    return jsonify({
        "total": len(students),
        "students": [
            student_to_dict(student)
            for student in students
        ]
    })


# READ - Get one student by ID
@app.route("/students/<int:student_id>", methods=["GET"])
def get_student(student_id):

    conn = get_db_connection()

    student = conn.execute(
        "SELECT * FROM students WHERE id = ?",
        (student_id,)
    ).fetchone()

    conn.close()

    if student is None:
        return jsonify({
            "error": "Student not found"
        }), 404

    return jsonify(student_to_dict(student))


# UPDATE - Edit student details
@app.route("/students/<int:student_id>", methods=["PUT"])
def update_student(student_id):

    data = request.get_json(silent=True)

    error = validate_student(data)

    if error:
        return jsonify({"error": error}), 400

    conn = get_db_connection()

    try:
        existing = conn.execute(
            "SELECT id FROM students WHERE id = ?",
            (student_id,)
        ).fetchone()

        if existing is None:
            return jsonify({
                "error": "Student not found"
            }), 404

        conn.execute("""
            UPDATE students
            SET rollNo = ?,
                name = ?,
                email = ?,
                phone = ?,
                department = ?,
                year = ?,
                gender = ?
            WHERE id = ?
        """, (
            data["rollNo"].strip(),
            data["name"].strip(),
            data["email"].strip(),
            data["phone"].strip(),
            data["department"].strip(),
            data["year"].strip(),
            data["gender"].strip(),
            student_id
        ))

        conn.commit()

        student = conn.execute(
            "SELECT * FROM students WHERE id = ?",
            (student_id,)
        ).fetchone()

        return jsonify({
            "message": "Student updated successfully",
            "student": student_to_dict(student)
        })

    except sqlite3.IntegrityError:
        return jsonify({
            "error": "Roll number already exists"
        }), 409

    finally:
        conn.close()


# DELETE - Remove a student
@app.route("/students/<int:student_id>", methods=["DELETE"])
def delete_student(student_id):

    conn = get_db_connection()

    student = conn.execute(
        "SELECT id FROM students WHERE id = ?",
        (student_id,)
    ).fetchone()

    if student is None:
        conn.close()

        return jsonify({
            "error": "Student not found"
        }), 404

    conn.execute(
        "DELETE FROM students WHERE id = ?",
        (student_id,)
    )

    conn.commit()
    conn.close()

    return jsonify({
        "message": "Student deleted successfully"
    })


# SEARCH - Find students
@app.route("/search", methods=["GET"])
def search_students():

    keyword = request.args.get("q", "").strip()

    if not keyword:
        return jsonify({
            "error": "Please enter a search keyword"
        }), 400

    search_value = "%" + keyword + "%"

    conn = get_db_connection()

    students = conn.execute("""
        SELECT * FROM students
        WHERE rollNo LIKE ?
           OR name LIKE ?
           OR email LIKE ?
           OR department LIKE ?
           OR year LIKE ?
        ORDER BY name
    """, (
        search_value,
        search_value,
        search_value,
        search_value,
        search_value
    )).fetchall()

    conn.close()

    return jsonify({
        "total": len(students),
        "students": [
            student_to_dict(student)
            for student in students
        ]
    })


# DASHBOARD - Student statistics
@app.route("/dashboard", methods=["GET"])
def dashboard():

    conn = get_db_connection()

    total = conn.execute(
        "SELECT COUNT(*) FROM students"
    ).fetchone()[0]

    departments = conn.execute(
        "SELECT COUNT(DISTINCT department) FROM students"
    ).fetchone()[0]

    male = conn.execute(
        "SELECT COUNT(*) FROM students WHERE gender = 'Male'"
    ).fetchone()[0]

    female = conn.execute(
        "SELECT COUNT(*) FROM students WHERE gender = 'Female'"
    ).fetchone()[0]

    conn.close()

    return jsonify({
        "totalStudents": total,
        "totalDepartments": departments,
        "maleStudents": male,
        "femaleStudents": female
    })


# Start application
if __name__ == "__main__":

    create_table()

    print("Student Management System Backend")
    print("Server running at http://127.0.0.1:5000")

    app.run(
        host="127.0.0.1",
        port=5000,
        debug=True
    )
