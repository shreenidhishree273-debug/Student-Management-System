
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f1f5f9;
            color: #1e293b;
            min-height: 100vh;
        }

        /* Navigation */
        nav {
            background: #1e3a8a;
            color: white;
            padding: 18px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        nav h2 {
            font-size: 22px;
        }

        nav span {
            font-size: 14px;
        }

        /* Main container */
        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .welcome {
            margin-bottom: 25px;
        }

        .welcome h1 {
            font-size: 28px;
            margin-bottom: 8px;
        }

        .welcome p {
            color: #64748b;
        }

        /* Dashboard cards */
        .dashboard {
            display: grid;
            grid-template-columns: repeat(
                auto-fit, minmax(200px, 1fr)
            );
            gap: 20px;
            margin-bottom: 30px;
        }

        .dashboard-card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 10px #0000000a;
            border-left: 5px solid #2563eb;
        }

        .dashboard-card h3 {
            color: #64748b;
            font-size: 15px;
            margin-bottom: 12px;
        }

        .dashboard-card p {
            font-size: 30px;
            font-weight: bold;
            color: #1e40af;
        }

        /* Main content */
        .content {
            display: grid;
            grid-template-columns: 1fr;
            gap: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 10px #0000000a;
        }

        .card h2 {
            margin-bottom: 20px;
            color: #1e3a8a;
            font-size: 22px;
        }

        /* Form */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(
                auto-fit, minmax(220px, 1fr)
            );
            gap: 18px;
        }

        .form-group label {
            display: block;
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 8px;
        }

        input, select {
            width: 100%;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font-size: 15px;
            background: white;
        }

        input:focus, select:focus {
            outline: 2px solid #bfdbfe;
            border-color: #2563eb;
        }

        /* Buttons */
        .button-group {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 22px;
        }

        button {
            border: none;
            padding: 11px 18px;
            border-radius: 7px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            transition: 0.2s;
        }

        button:hover {
            opacity: 0.85;
            transform: translateY(-1px);
        }

        .primary-btn {
            background: #2563eb;
            color: white;
        }

        .secondary-btn {
            background: #e2e8f0;
            color: #334155;
        }

        .edit-btn {
            background: #f59e0b;
            color: white;
            margin: 2px;
        }

        .delete-btn {
            background: #ef4444;
            color: white;
            margin: 2px;
        }

        /* Search */
        .search-area {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .search-area input {
            flex: 1;
            min-width: 200px;
        }

        /* Table */
        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 850px;
        }

        th, td {
            padding: 14px 12px;
            border-bottom: 1px solid #e2e8f0;
            text-align: left;
            font-size: 14px;
        }

        th {
            background: #eff6ff;
            color: #1e40af;
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        .empty-message {
            text-align: center;
            padding: 25px;
            color: #64748b;
        }

        .status {
            display: inline-block;
            background: #dcfce7;
            color: #166534;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        /* Footer */
        footer {
            background: #1e3a8a;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 35px;
        }

        @media (max-width: 600px) {
            .container {
                padding: 0 12px;
                margin: 20px auto;
            }

            .card {
                padding: 18px;
            }

            .welcome h1 {
                font-size: 23px;
            }

            nav {
                padding: 16px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <nav>
        <h2>🎓 Student Portal</h2>
        <span>Student Management System</span>
    </nav>

    <main class="container">

        <!-- Welcome Section -->
        <section class="welcome">
            <h1>Dashboard</h1>
            <p>Welcome! Manage your student records easily.</p>
        </section>

        <!-- Dashboard -->
        <section class="dashboard">

            <div class="dashboard-card">
                <h3>Total Students</h3>
                <p id="totalStudents">0</p>
            </div>

            <div class="dashboard-card">
                <h3>Total Departments</h3>
                <p id="totalDepartments">0</p>
            </div>

            <div class="dashboard-card">
                <h3>Male Students</h3>
                <p id="maleStudents">0</p>
            </div>

            <div class="dashboard-card">
                <h3>Female Students</h3>
                <p id="femaleStudents">0</p>
            </div>

        </section>

        <section class="content">

            <!-- Student Form -->
            <div class="card">

                <h2 id="formHeading">➕ Add New Student</h2>

                <form id="studentForm">

                    <div class="form-grid">

                        <div class="form-group">
                            <label for="rollNo">Roll Number</label>
                            <input type="text" id="rollNo"
                                placeholder="Enter roll number"
                                required>
                        </div>

                        <div class="form-group">
                            <label for="studentName">Student Name</label>
                            <input type="text" id="studentName"
                                placeholder="Enter student name"
                                required>
                        </div>

                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email"
                                placeholder="Enter email address"
                                required>
                        </div>

                        <div class="form-group">
                            <label for="phone">Phone Number</label>
                            <input type="tel" id="phone"
                                placeholder="10-digit phone number"
                                pattern="[0-9]{10}"
                                title="Enter a 10-digit phone number"
                                required>
                        </div>

                        <div class="form-group">
                            <label for="department">Department</label>
                            <select id="department" required>
                                <option value="">Select Department</option>
                                <option value="CSE">CSE</option>
                                <option value="CSE-AIML">CSE-AIML</option>
                                <option value="IT">IT</option>
                                <option value="ECE">ECE</option>
                                <option value="EEE">EEE</option>
                                <option value="MECH">MECH</option>
                                <option value="CIVIL">CIVIL</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="year">Year of Study</label>
                            <select id="year" required>
                                <option value="">Select Year</option>
                                <option value="1st Year">1st Year</option>
                                <option value="2nd Year">2nd Year</option>
                                <option value="3rd Year">3rd Year</option>
                                <option value="4th Year">4th Year</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="gender">Gender</label>
                            <select id="gender" required>
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                    </div>

                    <div class="button-group">
                        <button type="submit"
                            class="primary-btn"
                            id="submitButton">
                            Add Student
                        </button>

                        <button type="button"
                            class="secondary-btn"
                            onclick="resetForm()">
                            Clear Form
                        </button>
                    </div>

                </form>

            </div>

            <!-- Student Records -->
            <div class="card">

                <h2>📋 Student Records</h2>

                <div class="search-area">
                    <input type="text" id="searchInput"
                        placeholder="Search students..."
                        oninput="displayStudents()">
                </div>

                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Roll Number</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Department</th>
                                <th>Year</th>
                                <th>Gender</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody id="studentTable">
                        </tbody>

                    </table>

                </div>

            </div>

        </section>

    </main>

    <footer>
        <p>© 2026 Student Management System | Mini Project</p>
    </footer>

    <script>

        // Load student records
        let students = [];

        try {
            const savedStudents =
                localStorage.getItem("studentRecords");

            students = savedStudents
                ? JSON.parse(savedStudents)
                : [];

            if (!Array.isArray(students)) {
                students = [];
            }
        } catch (error) {
            students = [];
        }

        let editIndex = -1;

        const form = document.getElementById("studentForm");

        // Save data
        function saveData() {
            try {
                localStorage.setItem(
                    "studentRecords",
                    JSON.stringify(students)
                );
                return true;
            } catch (error) {
                alert("Unable to save student data.");
                return false;
            }
        }

        // Add or update student
        form.addEventListener("submit", function(event) {

            event.preventDefault();

            const student = {
                rollNo: document.getElementById("rollNo")
                    .value.trim(),

                name: document.getElementById("studentName")
                    .value.trim(),

                email: document.getElementById("email")
                    .value.trim(),

                phone: document.getElementById("phone")
                    .value.trim(),

                department: document.getElementById("department")
                    .value,

                year: document.getElementById("year").value,

                gender: document.getElementById("gender").value
            };

            if (Object.values(student).some(value => !value)) {
                alert("Please fill in all fields.");
                return;
            }

            // Check duplicate roll number
            const duplicate = students.some((s, index) =>
                s.rollNo.toLowerCase() ===
                student.rollNo.toLowerCase()
                && index !== editIndex
            );

            if (duplicate) {
                alert("Roll number already exists!");
                return;
            }

            if (editIndex === -1) {
                students.push(student);
            } else {
                students[editIndex] = student;
            }

            if (saveData()) {
                alert(
                    editIndex === -1
                    ? "Student added successfully!"
                    : "Student updated successfully!"
                );

                resetForm();
                displayStudents();
            }

        });

        // Display records
        function displayStudents() {

            const table = document.getElementById("studentTable");

            const search = document.getElementById("searchInput")
                .value.trim().toLowerCase();

            const filteredStudents = students
                .map((student, index) => ({ student, index }))
                .filter(({ student }) =>
                    Object.values(student).some(value =>
                        String(value).toLowerCase().includes(search)
                    )
                );

            table.innerHTML = "";

            if (filteredStudents.length === 0) {

                const row = document.createElement("tr");
                const cell = document.createElement("td");

                cell.colSpan = 9;
                cell.className = "empty-message";
                cell.textContent = "No student records found.";

                row.appendChild(cell);
                table.appendChild(row);

            } else {

                filteredStudents.forEach(({ student, index }) => {

                    const row = document.createElement("tr");

                    const values = [
                        student.rollNo,
                        student.name,
                        student.email,
                        student.phone,
                        student.department,
                        student.year,
                        student.gender
                    ];

                    values.forEach(value => {
                        const cell = document.createElement("td");
                        cell.textContent = value;
                        row.appendChild(cell);
                    });

                    // Status
                    const statusCell = document.createElement("td");
                    const status = document.createElement("span");

                    status.className = "status";
                    status.textContent = "Active";

                    statusCell.appendChild(status);
                    row.appendChild(statusCell);

                    // Actions
                    const actionCell = document.createElement("td");

                    const editButton =
                        document.createElement("button");

                    editButton.textContent = "Edit";
                    editButton.className = "edit-btn";
                    editButton.onclick = () => editStudent(index);

                    const deleteButton =
                        document.createElement("button");

                    deleteButton.textContent = "Delete";
                    deleteButton.className = "delete-btn";
                    deleteButton.onclick = () => deleteStudent(index);

                    actionCell.appendChild(editButton);
                    actionCell.appendChild(deleteButton);

                    row.appendChild(actionCell);
                    table.appendChild(row);

                });

            }

            updateDashboard();

        }

        // Edit student
        function editStudent(index) {

            const student = students[index];

            document.getElementById("rollNo").value =
                student.rollNo;

            document.getElementById("studentName").value =
                student.name;

            document.getElementById("email").value =
                student.email;

            document.getElementById("phone").value =
                student.phone;

            document.getElementById("department").value =
                student.department;

            document.getElementById("year").value =
                student.year;

            document.getElementById("gender").value =
                student.gender;

            editIndex = index;

            document.getElementById("formHeading").textContent =
                "✏️ Edit Student";

            document.getElementById("submitButton").textContent =
                "Update Student";

            document.getElementById("studentForm")
                .scrollIntoView({ behavior: "smooth" });

        }

        // Delete student
        function deleteStudent(index) {

            const confirmDelete = confirm(
                "Are you sure you want to delete this student?"
            );

            if (!confirmDelete) return;

            const deletedStudent = students.splice(index, 1);

            if (saveData()) {
                displayStudents();
                resetForm();
                alert("Student deleted successfully!");
            } else {
                students.splice(index, 0, ...deletedStudent);
            }

        }

        // Reset form
        function resetForm() {

            form.reset();

            editIndex = -1;

            document.getElementById("formHeading").textContent =
                "➕ Add New Student";

            document.getElementById("submitButton").textContent =
                "Add Student";

        }

        // Dashboard statistics
        function updateDashboard() {

            document.getElementById("totalStudents")
                .textContent = students.length;

            const departments = new Set(
                students.map(student => student.department)
            );

            document.getElementById("totalDepartments")
                .textContent = departments.size;

            document.getElementById("maleStudents")
                .textContent = students.filter(
                    student => student.gender === "Male"
                ).length;

            document.getElementById("femaleStudents")
                .textContent = students.filter(
                    student => student.gender === "Female"
                ).length;

        }

        // Initial display
        displayStudents();

    </script>

</body>
</html>
